# Shared local defaults. Copy this file to `.env` for local development.
APP_ENV=development

# Keep true for the reliable local guest/demo path.
USE_MOCK_DATA=true

# Leave empty for guest/mock mode. Fill both values to enable Supabase Auth.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional FastAPI AI service. Not required for the default mock preview.
AI_SERVICE_BASE_URL=http://localhost:8000

# Leave empty for the fail-closed staging/production default. Development debug
# defaults on; staging and production require exact `true`.
COACH_SURFACE_ENABLED=

# Backend only. Empty disables cloud BYOK providers. Never put provider keys in
# this file; users supply them per request from secure device/tab storage.
COACH_BYOK_PROVIDERS=

# Development pilot only. Keep false unless both Flutter and FastAPI should
# expose separately consented learned Focus timing for new plan previews.
LEARNED_FOCUS_PLANNING_PILOT_ENABLED=false
