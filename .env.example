# Shared local defaults. Copy this file to `.env` for local development.
APP_ENV=development

# Keep true for the reliable local guest/demo path.
USE_MOCK_DATA=true

# Leave empty for guest/mock mode. Fill the URL and one client key to enable
# Supabase Auth. Current hosted builds use SUPABASE_PUBLISHABLE_KEY. The legacy
# anon name remains only for local Supabase and a bounded staging transition.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# Non-secret hosted identity guards. Staging and pilot builds bind the URL to
# their exact 20-letter ref and reject equal/crossed refs. Local development
# leaves both empty. The real pilot ref is added only after authorized setup.
STAGING_SUPABASE_PROJECT_REF=
PILOT_SUPABASE_PROJECT_REF=

# Optional FastAPI AI service. Not required for the default mock preview.
AI_SERVICE_BASE_URL=http://localhost:8000

# Leave empty for the fail-closed staging/pilot/production default. Development
# debug defaults on; hosted environments require exact `true`.
COACH_SURFACE_ENABLED=

# Backend only. Empty disables cloud BYOK providers. Never put provider keys in
# this file; users supply them per request from secure device/tab storage.
COACH_BYOK_PROVIDERS=

# Development pilot only. Keep false unless both Flutter and FastAPI should
# expose separately consented learned Focus timing for new plan previews.
LEARNED_FOCUS_PLANNING_PILOT_ENABLED=false
