APP_ENV=development
API_PREFIX=/v1
ALLOWED_ORIGINS=http://127.0.0.1:7357,http://localhost:7357

# Required for authenticated persistence workflows.
SUPABASE_URL=

# Non-secret hosted identity guards. Leave empty for local development. A
# staging/pilot process binds SUPABASE_URL to its exact configured project.
STAGING_SUPABASE_PROJECT_REF=
PILOT_SUPABASE_PROJECT_REF=

# Backend-only keys. Hosted pilot uses the current secret-key name. The legacy
# service-role JWT remains compatible for local Supabase and staged migration;
# when both exist the current key wins. Never expose either value to Flutter.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_TIMEOUT_SECONDS=10

# Backend-only token used by the scheduled daily preparation endpoint.
SCHEDULED_REFRESH_TOKEN=

# Development-only rollout gate. Learned timing remains separately opt-in per
# account and is never enabled by this flag alone.
LEARNED_FOCUS_PLANNING_PILOT_ENABLED=false

# Coach is off by default. The fake provider is deterministic and intended only
# for automated development/test journeys.
COACH_PROVIDER=disabled
COACH_FAKE_PROVIDER_ENABLED=false

# Development-only subscription-backed adapter. Enabling it requires an
# already authenticated local Codex CLI; OAuth state stays outside this repo.
LOCAL_CODEX_ENABLED=false
LOCAL_CODEX_BIN=codex
LOCAL_CODEX_MODEL=gpt-5.5
LOCAL_CODEX_TIMEOUT_SECONDS=45
LOCAL_CODEX_MAX_REQUESTS_PER_USER_PER_DAY=20
LOCAL_CODEX_GLOBAL_CONCURRENCY=2

# Separate bounded guards for deterministic historical Coach evidence. These
# do not make the local Codex OAuth adapter a production multi-user provider.
COACH_EVIDENCE_TIMEOUT_SECONDS=15
COACH_EVIDENCE_GLOBAL_CONCURRENCY=4
