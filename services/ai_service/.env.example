APP_ENV=development
API_PREFIX=/v1
APP_BUILD_SHA=
APP_RELEASE_TAG=
APP_MIGRATION_HEAD=
APP_MIGRATION_COUNT=0
APP_MIGRATION_IDENTITY_SHA256=
ALLOWED_ORIGINS=http://127.0.0.1:7357,http://localhost:7357
USE_MOCK_DATA=true

# Required for authenticated persistence workflows.
SUPABASE_URL=

# Non-secret hosted identity guards. Leave empty for local development. A
# staging/pilot process binds SUPABASE_URL to its exact configured project.
STAGING_SUPABASE_PROJECT_REF=
PILOT_SUPABASE_PROJECT_REF=

# Backend-only keys. Hosted pilot uses the current secret-key name. The legacy
# service-role JWT remains compatible for local Supabase and staged migration;
# when both exist the current key wins. Never expose either value to Flutter.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_TIMEOUT_SECONDS=10

# Hosted-only, backend-owned append-only deletion recovery journal. The bucket
# must have versioning and S3 Object Lock enabled; the key is write-only for
# this prefix and the KMS key is dedicated to the journal. Never expose these
# values to Flutter or the Coach executor.
ACCOUNT_DELETION_JOURNAL_S3_URL=
ACCOUNT_DELETION_JOURNAL_S3_REGION=
ACCOUNT_DELETION_JOURNAL_S3_ACCESS_KEY_ID=
ACCOUNT_DELETION_JOURNAL_S3_SECRET_ACCESS_KEY=
ACCOUNT_DELETION_JOURNAL_S3_KMS_KEY_ARN=
ACCOUNT_DELETION_JOURNAL_TIMEOUT_SECONDS=10

# Backend-only token used by the scheduled daily preparation endpoint.
SCHEDULED_REFRESH_TOKEN=

# Development-only rollout gate. Learned timing remains separately opt-in per
# account and is never enabled by this flag alone.
LEARNED_FOCUS_PLANNING_PILOT_ENABLED=false

# Coach is off by default. The fake provider is deterministic and intended only
# for automated development/test journeys.
COACH_PROVIDER=disabled
COACH_FAKE_PROVIDER_ENABLED=false
COACH_BYOK_PROVIDERS=

# Hosted pilot only. This is an explicit provider choice, never a fallback.
# The API process owns no Codex OAuth state or Docker access; it connects to a
# separately sandboxed executor over this Unix socket. Keep the gate false for
# normal local development and on hosts without the reviewed executor setup.
OPERATOR_CODEX_PILOT_ENABLED=false
COACH_EXECUTOR_SOCKET_PATH=/run/mylifegraph-coach/executor.sock
COACH_EXECUTOR_ALLOWED_API_UID=0
COACH_OPERATOR_MODEL=gpt-5.5
COACH_OPERATOR_REQUESTS_PER_USER_PER_DAY=5
COACH_OPERATOR_GLOBAL_REQUESTS_PER_DAY=15
COACH_OPERATOR_GLOBAL_CONCURRENCY=1
COACH_OPERATOR_RETRY_AFTER_SECONDS=15
COACH_AGENT_TIMEOUT_SECONDS=180

# Development-only subscription-backed adapter. Enabling it requires an
# already authenticated local Codex CLI; OAuth state stays outside this repo.
LOCAL_CODEX_ENABLED=false
LOCAL_CODEX_BIN=codex
LOCAL_CODEX_EXPECTED_VERSION=
LOCAL_CODEX_MODEL=gpt-5.5
LOCAL_CODEX_TIMEOUT_SECONDS=45
LOCAL_CODEX_MAX_REQUESTS_PER_USER_PER_DAY=20
LOCAL_CODEX_GLOBAL_CONCURRENCY=2

# The analysis runtime defaults to the local Docker context in development.
# A hosted executor must set an exact rootless socket of the form
# unix:///run/user/<executor-uid>/docker.sock.
COACH_ANALYSIS_DOCKER_BIN=docker
COACH_ANALYSIS_DOCKER_HOST=
COACH_ANALYSIS_IMAGE=mylifegraph-coach-analysis:1

# Separate bounded guards for deterministic historical Coach evidence. These
# do not make the local Codex OAuth adapter a production multi-user provider.
COACH_EVIDENCE_TIMEOUT_SECONDS=15
COACH_EVIDENCE_GLOBAL_CONCURRENCY=4

# Hosted single-worker HTTP admission. These are abuse/capacity controls, not
# registration caps or durable Coach billing/quota authority.
PUBLIC_ADMISSION_WAIT_MILLISECONDS=50
PUBLIC_READY_IP_REQUESTS_PER_MINUTE=60
PUBLIC_READY_CONCURRENCY=4
PUBLIC_READ_IP_REQUESTS_PER_MINUTE=300
PUBLIC_READ_OWNER_REQUESTS_PER_MINUTE=180
PUBLIC_READ_CONCURRENCY=32
PUBLIC_MUTATION_IP_REQUESTS_PER_MINUTE=120
PUBLIC_MUTATION_OWNER_REQUESTS_PER_MINUTE=60
PUBLIC_MUTATION_CONCURRENCY=8
PUBLIC_COACH_IP_REQUESTS_PER_MINUTE=60
PUBLIC_COACH_OWNER_REQUESTS_PER_MINUTE=12
PUBLIC_COACH_CONCURRENCY=4
