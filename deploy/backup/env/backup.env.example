# Protected off-host runner only. Values are examples/placeholders.
PILOT_SUPABASE_PROJECT_REF=<exact-20-letter-pilot-ref>
PILOT_PUBLIC_APP_ORIGIN=https://app.example.invalid
PILOT_EXPECTED_MIGRATION_HEAD=<deployed-14-digit-version_name.sql>
TURNSTILE_SITE_KEY=<public-turnstile-site-key>
SUPABASE_ACCESS_TOKEN=<protected-management-api-access-token>
SUPABASE_DB_URL=postgresql://postgres.<pilot-ref>@<session-pooler-host>:5432/postgres?sslmode=require
SUPABASE_DB_PASSWORD=<database-password>
SUPABASE_BIN=/usr/local/bin/supabase
SUPABASE_EXPECTED_VERSION=2.107.0
RESTIC_BIN=/opt/mylifegraph/restic/current/restic
RESTIC_EXPECTED_VERSION=0.19.1
RESTIC_REPOSITORY=<off-host-restic-repository>
RESTIC_PASSWORD_FILE=/etc/mylifegraph-backup/restic-password
BACKUP_HEARTBEAT_CURL_CONFIG=/etc/mylifegraph-backup/heartbeat.curlrc
# Exact true only for the monthly/pre-release physically isolated DB rehearsal.
RUN_DATABASE_RESTORE_REHEARSAL=false
# Read/list/KMS-decrypt authority is present only during an isolated rehearsal.
# It is separate from the API's write-only journal credential.
ACCOUNT_DELETION_JOURNAL_S3_URL=https://<bucket>.s3.<region>.amazonaws.com
ACCOUNT_DELETION_JOURNAL_S3_REGION=<region>
ACCOUNT_DELETION_JOURNAL_S3_KMS_KEY_ARN=arn:aws:kms:<region>:<account>:key/<uuid>
DELETION_JOURNAL_READ_ACCESS_KEY_ID=<recovery-read-access-id>
DELETION_JOURNAL_READ_SECRET_ACCESS_KEY=<recovery-read-secret>
DELETION_JOURNAL_READ_SESSION_TOKEN=
# `pre_migration` is protected for 35 days and `release_candidate` for 14;
# scheduled jobs use `routine`.
BACKUP_RETENTION_CLASS=routine
# Backend-specific Restic credentials belong in this same protected store.
AWS_ACCESS_KEY_ID=<scoped-backup-access-id>
AWS_SECRET_ACCESS_KEY=<scoped-backup-secret>
AWS_DEFAULT_REGION=<backup-region>
