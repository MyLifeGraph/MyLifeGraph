# Install as /etc/mylifegraph/executor.env, root:coach-executor, mode 0640.
# This file is deliberately secret-free. Numeric UIDs must be resolved by ops.
APP_ENV=pilot
USE_MOCK_DATA=false
# Enable only for the held candidate after the account/terms and privacy gates.
OPERATOR_CODEX_PILOT_ENABLED=false
COACH_EXECUTOR_SOCKET_PATH=/run/mylifegraph-coach/executor.sock
COACH_EXECUTOR_ALLOWED_API_UID=<mylifegraph-api-uid>
LOCAL_CODEX_BIN=/opt/mylifegraph/codex/current/bin/codex
LOCAL_CODEX_EXPECTED_VERSION=0.148.0
COACH_OPERATOR_MODEL=gpt-5.5
COACH_AGENT_TIMEOUT_SECONDS=180
COACH_ANALYSIS_DOCKER_BIN=/usr/bin/docker
COACH_ANALYSIS_DOCKER_HOST=unix:///run/user/<coach-executor-uid>/docker.sock
# COACH_ANALYSIS_IMAGE is generated from the verified release sources and
# loaded from .mylifegraph-executor-release.env after this mutable file.
HOME=/var/lib/mylifegraph-coach
CODEX_HOME=/var/lib/mylifegraph-coach/codex-home
TMPDIR=/var/lib/mylifegraph-coach/tmp
XDG_RUNTIME_DIR=/run/user/<coach-executor-uid>
PATH=/opt/mylifegraph/codex/current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
LANG=C.UTF-8
