# Install as /etc/mylifegraph/api.env, root:mylifegraph-api, mode 0640.
# Replace every angle-bracket value without logging the result.
APP_ENV=pilot
# APP_BUILD_SHA, APP_RELEASE_TAG, and APP_MIGRATION_* come from the verified
# release manifest, not from this mutable host configuration.
ALLOWED_ORIGINS=https://app.example.invalid
SUPABASE_URL=https://<pilot-project-ref>.supabase.co
SUPABASE_SECRET_KEY=<current-backend-secret-key>
STAGING_SUPABASE_PROJECT_REF=<distinct-staging-project-ref>
PILOT_SUPABASE_PROJECT_REF=<pilot-project-ref>
SUPABASE_TIMEOUT_SECONDS=10
ACCOUNT_DELETION_JOURNAL_S3_URL=https://<journal-bucket>.s3.<aws-region>.amazonaws.com
ACCOUNT_DELETION_JOURNAL_S3_REGION=<aws-region>
ACCOUNT_DELETION_JOURNAL_S3_ACCESS_KEY_ID=<write-only-access-key-id>
ACCOUNT_DELETION_JOURNAL_S3_SECRET_ACCESS_KEY=<write-only-secret-access-key>
ACCOUNT_DELETION_JOURNAL_S3_KMS_KEY_ARN=arn:aws:kms:<aws-region>:<account-id>:key/<key-id>
ACCOUNT_DELETION_JOURNAL_TIMEOUT_SECONDS=10
USE_MOCK_DATA=false
LEARNED_FOCUS_PLANNING_PILOT_ENABLED=false
COACH_PROVIDER=disabled
COACH_BYOK_PROVIDERS=openai,gemini
COACH_FAKE_PROVIDER_ENABLED=false
LOCAL_CODEX_ENABLED=false
OPERATOR_CODEX_PILOT_ENABLED=true
COACH_EXECUTOR_SOCKET_PATH=/run/mylifegraph-coach/executor.sock
COACH_OPERATOR_MODEL=gpt-5.5
COACH_OPERATOR_REQUESTS_PER_USER_PER_DAY=5
COACH_OPERATOR_GLOBAL_REQUESTS_PER_DAY=15
COACH_OPERATOR_GLOBAL_CONCURRENCY=1
COACH_OPERATOR_RETRY_AFTER_SECONDS=15
COACH_AGENT_TIMEOUT_SECONDS=180
LOCAL_CODEX_GLOBAL_CONCURRENCY=1
COACH_EVIDENCE_GLOBAL_CONCURRENCY=4
COACH_EVIDENCE_TIMEOUT_SECONDS=15
PUBLIC_ADMISSION_WAIT_MILLISECONDS=50
PUBLIC_READY_IP_REQUESTS_PER_MINUTE=60
PUBLIC_READY_CONCURRENCY=4
PUBLIC_READ_IP_REQUESTS_PER_MINUTE=300
PUBLIC_READ_OWNER_REQUESTS_PER_MINUTE=180
PUBLIC_READ_CONCURRENCY=32
PUBLIC_MUTATION_IP_REQUESTS_PER_MINUTE=120
PUBLIC_MUTATION_OWNER_REQUESTS_PER_MINUTE=60
PUBLIC_MUTATION_CONCURRENCY=8
PUBLIC_COACH_IP_REQUESTS_PER_MINUTE=60
PUBLIC_COACH_OWNER_REQUESTS_PER_MINUTE=12
PUBLIC_COACH_CONCURRENCY=4
